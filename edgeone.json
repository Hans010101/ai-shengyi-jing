      ]
    },
    {
      "source": "/data/case_collection_dates.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=1800, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}

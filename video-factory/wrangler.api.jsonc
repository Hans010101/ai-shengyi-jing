{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-shengyi-video-factory",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/output/*", "/internal/*"]
  },
  "ai": { "binding": "AI" },
  "r2_buckets": [
    { "binding": "VIDEO_BUCKET", "bucket_name": "ai-shengyi-video-factory" }
  ],
  "d1_databases": [
    { "binding": "VIDEO_DB", "database_name": "ai-shengyi-video-factory", "database_id": "326c208e-23dd-4cf8-809d-29d22501e121" }
  ],
  "workflows": [
    {
      "name": "ai-shengyi-video-production",
      "binding": "VIDEO_WORKFLOW",
      "class_name": "VideoProductionWorkflow"
    }
  ],
  "vars": {
    "PROJECT_DATA_URL": "https://ai-shengyi-jing.pages.dev/data/projects_live.json",
    "ARTICLE_DATA_URL": "https://ai-shengyi-jing.pages.dev/data/case_articles.json",
    "ARTICLE_BASE_URL": "https://ai-shengyi-jing.pages.dev/data/case_articles",
    "SCRIPT_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "ASR_MODEL": "@cf/openai/whisper-large-v3-turbo",
    "FACTORY_VERSION": "0.4.0",
    "AUTO_BATCH_SIZE": "0",
    "ARTIFACT_RETENTION_DAYS": "3",
    "RENDERER_ENABLED": "false",
    "PUBLIC_ORIGIN": "https://ai-shengyi-video-factory.hans-pan007.workers.dev"
  },
  "observability": { "enabled": true }
}
